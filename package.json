{
  "name": "sql-client",
  "version": "0.1.0",
  "description": "Local SQL client for PostgreSQL and MySQL",
  "author": "Bustanil Arifin",
  "private": true,
  "main": "electron/dist/main.js",
  "scripts": {
    "build:electron": "tsc -p electron/tsconfig.json",
    "dev:ui": "node scripts/dev-ui.ts",
    "dev": "npm run build:electron && node scripts/dev.ts",
    "test": "go test ./...",
    "pack": "npm run build:electron && go build -o dist/sql-client-server ./cmd/server && npm --prefix web run build && electron-builder --mac dir"
  },
  "build": {
    "appId": "com.bustanil.sqlclient",
    "productName": "SQL Client",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/sql-client-server",
        "to": "sql-client-server"
      },
      {
        "from": "web/dist",
        "to": "web"
      }
    ],
    "mac": {
      "identity": null,
      "target": [
        "dir"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  }
}
